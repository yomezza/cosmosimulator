# Documentation only: the executable reads process environment, not this file.
DATABASE_URL=postgres://cosmos:CHANGE_ME@127.0.0.1:5432/cosmosimulator?sslmode=disable
# Optional: use a dedicated schema in the existing database; default is public.
DB_SCHEMA=cosmosimulator
HTTP_ADDR=127.0.0.1:8080
# Set both only to bootstrap a new admin. No default credentials.
ADMIN_USERNAME=operator
ADMIN_PASSWORD=REPLACE_WITH_A_UNIQUE_PASSWORD
# For HTTPS reverse proxy deployments:
# PUBLIC_ORIGIN=https://game.example.com
# COOKIE_SECURE=true

# Trust only the actual reverse proxy networks, never arbitrary client headers.
# The proxy must set/append the real client address in X-Forwarded-For.
# TRUSTED_PROXIES=127.0.0.1/32,::1/128
